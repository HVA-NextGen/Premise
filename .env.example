# Premise reads these at runtime (server-side only). Copy to `.env.local` and fill in.
# Never commit real values.

# Base URL of your Azure API Management AI gateway, up to (not including) /openai.
# Example: https://my-apim.azure-api.net  (or https://my-apim.azure-api.net/<api-suffix>)
APIM_GATEWAY_URL=

# APIM subscription key used to authenticate the app to the gateway.
APIM_SUBSCRIPTION_KEY=

# The model deployment name behind the gateway (the Foundry/Azure OpenAI deployment).
APIM_MODEL_DEPLOYMENT_NAME=

# Optional. Azure OpenAI API version. Defaults to a version that supports
# structured outputs (json_schema) if left blank.
APIM_API_VERSION=
